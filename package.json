{
  "name": "yebomart-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr seo/entry.tsx --outDir dist-seo && npm run seo:build",
    "preview": "vite preview",
    "build:before-seo": "tsc -b && vite build",
    "seo:build": "node node_modules/@omevision/static-seo/site.mjs",
    "postbuild": "node analytics/build.mjs",
    "seo:prepare": "node node_modules/@omevision/static-seo/site.mjs --prepare",
    "prebuild": "npm run seo:prepare"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "@omevision/static-seo": "file:vendor/omevision-static-seo-0.4.3.tgz"
  }
}
